---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ScreenSnippet from "../../components/ScreenSnippet";
import { projects } from "../../constants";

// Only Show the selected project from the projects array
const filteredProject = projects.filter((project) => {
  return project.link === "project/buying-home-in-california";
});
const project = { ...filteredProject[0] };
---

<ProjectLayout
  project={project}
  title="Real Estate Website - Takinur Portfolio"
>
  <ScreenSnippet source="/images/Real-Estate.gif" name="Main Screen" />
  <ScreenSnippet
    source="/images/real-estate-categories.webp"
    name="Categories"
  />
  <ScreenSnippet source="/images/real-estate-about.webp" name="About Page" />
  <ScreenSnippet source="/images/real-estate-home.webp" name="Landing Page" />
</ProjectLayout>
