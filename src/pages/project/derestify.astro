---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ScreenSnippet from "../../components/ScreenSnippet";
import { projects } from "../../constants";

// Only Show the selected project from the projects array
const filteredProject = projects.filter((project) => {
  return project.link === "project/derestify";
});
const project = { ...filteredProject[0] };
---

<ProjectLayout project={project} title="Serverless Project - Takinur Portfolio">
  <ScreenSnippet
    source="/images/serverless-architect.png"
    name="APP Architecture"
  />
</ProjectLayout>
