---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ScreenSnippet from "../../components/ScreenSnippet";
import { projects } from "../../constants";

// Only Show the selected project from the projects array
const filteredProject = projects.filter((project) => {
  return project.link === "project/driverless"; // Change this to the link of the project
});
const project = { ...filteredProject[0] };
---

<ProjectLayout
  project={project}
  title="Driverless Project - Takinur Web Developer Portfolio"
>
  <ScreenSnippet source={"/images/driverless.gif"} name="Landing Pages" />
  <ScreenSnippet
    source={"/images/driverless-login.webp"}
    name="User Profile Screen"
  />
  <ScreenSnippet source={"/images/driverless-other.webp"} name="Social Feed" />
  <ScreenSnippet
    source={"/images/driverless-tech.webp"}
    name="Technology Page"
  />
  <ScreenSnippet
    source={"/images/driverless-backend.webp"}
    name="Setup Screen"
  />
</ProjectLayout>
