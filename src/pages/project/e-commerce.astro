---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ScreenSnippet from "../../components/ScreenSnippet";
import { projects } from "../../constants";

// Only Show the selected project from the projects array
const filteredProject = projects.filter((project) => {
  return project.link === "project/e-commerce";
});
const project = { ...filteredProject[0] };
---

<ProjectLayout project={project} title="E-Commerce Project - Takinur Portfolio">
  <ScreenSnippet source="/images/e-commerce-landing.png" name="Landing Page" />
  <ScreenSnippet source="/images/e-commerce-cart.png" name="Shop Cart" />
  <ScreenSnippet
    source="/images/e-commer-slider.png"
    name=" Purchase Categories "
  />
</ProjectLayout>
