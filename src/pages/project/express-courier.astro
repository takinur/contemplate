---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ScreenSnippet from "../../components/ScreenSnippet";
import { projects } from "../../constants";

// Only Show the selected project from the projects array
const filteredProject = projects.filter((project) => {
  return project.link === "project/express-courier"; // Change this to the link of the project
});
const project = { ...filteredProject[0] };
---

<ProjectLayout
  title="Courier Application - Takinur Portfolio"
  project={project}
>
  <ScreenSnippet name="Home Page" source={"/images/courier-site.gif"} />
  <ScreenSnippet name="Admin Dashboard" source={"/images/courier-admin.webp"} />
  <ScreenSnippet name="About Page" source={"/images/courier-about.webp"} />
  <ScreenSnippet name="Site Setting" source={"/images/courier-setting.webp"} />
</ProjectLayout>
