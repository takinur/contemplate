---
import Layout from "../../layouts/Layout.astro";
import "../index.css";
import ScreenSnippet from "../../components/ScreenSnippet";
import Logo from "../../assets/logo.png";
import artHero from "../../assets/art-painting.webp";
import artContact from "../../assets/art-contact.webp";
import artCollection from "../../assets/art-collection.png";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { projects } from "../../constants";

// Only Show the selected project from the projects array
const filteredProject = projects.filter((project) => {
  return project.link === "project/original-art";
});
const project = { ...filteredProject[0] };
---

<ProjectLayout
  title="Art Selling Project - Takinur Portfolio"
  project={project}
>
  <ScreenSnippet source={"/images/art_site.gif"} name="Main Screen" />
  <ScreenSnippet source={artCollection} name="Collection Page" />
  <ScreenSnippet source={artContact} name="Contact Page" />
</ProjectLayout>
