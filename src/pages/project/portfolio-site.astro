---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { projects } from "../../constants";
import ScreenSnippet from "../../components/ScreenSnippet";

import skill from "../../assets/portfolio-skills.png";
import edu from "../../assets/portfolio-edu.png";
import works from "../../assets/portfolio-works.png";

// Only Show the selected project from the projects array
const filteredProject = projects.filter((project) => {
  return project.link === "project/skirmisherai";
});
const project = { ...filteredProject[0] };
---

<ProjectLayout
  project={project}
  title="Takinur M - Software Engineer Portfolio"
>
  <ScreenSnippet name="Hero Section" source={"/images/portfolio-thumb.png"} />
  <ScreenSnippet name="Skills & Experiences" source={skill} />
  <ScreenSnippet name="Projects Section" source={works} />
  <ScreenSnippet name="Education" source={edu} />
</ProjectLayout>
