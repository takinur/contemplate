---
import ScreenSnippet from "../../components/ScreenSnippet";

import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { projects } from "../../constants";

// Only Show the selected project from the projects array
const filteredProject = projects.filter((project) => {
  return project.link === "project/ski-beyond"; // Change this to the link of the project
});
const project = { ...filteredProject[0] };
---

<ProjectLayout project={project} title="Skiing App - Takinur Portfolio">
  <div class="flex flex-col items-center content-center justify-center">
    <div class="w-96">
      <ScreenSnippet
        source={"/images/ski-beyond.png"}
        name={"Welcome Screen"}
      />
    </div>
    <div class="w-96">
      <ScreenSnippet
        source={"/images/ski-beyond.png"}
        name={"Welcome Screen"}
      />
    </div>
    <div class="w-96">
      <ScreenSnippet
        source={"/images/ski-acc.png"}
        name={"User Account Screen"}
      />
    </div>
    <div class="w-96">
      <ScreenSnippet source={"/images/ski-log.png"} name={"Activity Screen"} />
    </div>
    <div class="w-96">
      <ScreenSnippet
        source={"/images/ski-friends.png"}
        name={"Friends Screen"}
      />
    </div>
    <div class="w-96">
      <ScreenSnippet source={"/images/ski-record.png"} name={"Record Screen"} />
    </div>
    <div class="w-96">
      <ScreenSnippet
        source={"/images/ski-resorts.png"}
        name={"Resorts Screen"}
      />
    </div>
  </div>
</ProjectLayout>
