---
import Layout from "../../layouts/Layout.astro";
import "../index.css";
import Logo from "../../assets/logo.png";
---

<Layout title="Takinur M - Software Engineer">
  <!-- Whole Page Wrapper -->
  <div class="w-full bg-[#2b2b33] h-screen overflow-x-hidden">
    <div class="grid grid-cols-5">
      <div class="flex justify-center pt-20">
        <a href="/" class="animate-pulse">
          <img src={Logo} class="w-10 md:w-20" alt="Logo of Takinur" />
        </a>
      </div>
      <div class="col-span-3">
        <div class="hero-image-wrapper">
          <img
            class="object-cover mt-12 md:absolute md:-top-24 rounded-3xl"
            src="https://itssharl.ee/_next/image?url=https%3A%2F%2Fmedia.graphassets.com%2FHHugGSL1RwqNpqQeR86r&w=1920&q=75"
            alt=""
          />
        </div>
        <div class="project-description mt-8 md:mt-8">
          <h1
            class="md:text-5xl font-roboto ml-3 text-2xl font-bold uppercase bg-gradient-to-r from-violet-500 to-green-500 bg-clip-text text-transparent"
          >
            SkirmisherAI
          </h1>
          <hr class="w-11/12 mt-1 ml-4" />
          <div class="md:grid grid-cols-3 mt-4 w-full">
            <div class="main-wrapper col-span-2">
              <div class="content-wrapper grid grid-cols-2">
                <div
                  class="categories uppercase text-xl font-bold text-[#77d0ce]"
                >
                  <h6>Title</h6>
                </div>
                <div class="text-base text-zinc-100 font-poppins">
                  <p>
                    AI Powered Talent Screening Progressive Web Application.
                  </p>
                </div>
              </div>
              <div class="content-wrapper mt-4 grid grid-cols-2">
                <div
                  class="categories uppercase text-xl font-bold text-[#77d0ce]"
                >
                  <h6>Tech Stack</h6>
                </div>
                <div class="text-base text-zinc-100 font-poppins">
                  <p>
                    Python, React, Django, JavaScript, Tensorflow, TailwindCSS,
                    PostgreSQL
                  </p>
                </div>
              </div>
              <div class="content-wrapper mt-2 grid grid-cols-2">
                <div
                  class="categories uppercase text-xl font-bold text-[#77d0ce]"
                >
                  <h6>Year</h6>
                </div>
                <div class="text-base text-zinc-100 font-poppins">2022</div>
              </div>
            </div>
            <div
              class="wrapper-description mt-8 md:mt-0 px-0 text-zinc-100 md:px-4"
            >
              <p class="" >
                SkirmisherAI is a progressive web application that uses AI to
                screen candidates for a job. It is a project that I am working
                on with a team of 4 people. I am responsible for the frontend
                development of the project. I am using React, TailwindCSS, and
                Django for the frontend development. I am also using Tensorflow
                for the AI part of the project.
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="flex justify-center pt-20">
        <a href="/" class="">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="md:w-16 w-8 h-8 md:h-16 text-gray-400 hover:opacity-80 cursor-pointer"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .hero-image-wrapper {
    font-family: studiofeixen-variable, studiofeixen, Arial, Helvetica,
      sans-serif;
    letter-spacing: -0.015em;
    -webkit-font-smoothing: antialiased;
    font-variation-settings: "wght" 500, "wdth" 100;
    font-weight: unset;
    font-size: 1em;
    pointer-events: auto;
    --accentColor: #46509c;
    --accentColorDark: #77d0ce;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    width: 100%;
    height: calc(var(--innerVh, 1vh) * 75);
    position: relative;
  }
  @media (max-width: 768px) {
    .hero-image-wrapper {
      height: auto;
    }
  }
</style>
