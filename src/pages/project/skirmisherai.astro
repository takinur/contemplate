---
import termsPage from "../../assets/skirmisher-terms.png";
import ScreenSnippet from "../../components/ScreenSnippet";
import dashboard from "../../assets/skirmisher-dashboard.png";
import { projects } from "../../constants";
import ProjectLayout from "../../layouts/ProjectLayout.astro";

// Only Show the selected project from the projects array
const filteredProject = projects.filter((project) => {
  return project.link === "project/skirmisherai";
});
const project = { ...filteredProject[0] };
---

<ProjectLayout
  project={project}
  title="Talent Screening Project - Takinur Portfolio"
>
  <ScreenSnippet
    source="/images/skirmihser-landing.png"
    name={"Landing Page"}
  />
  <ScreenSnippet source={dashboard} name={"Dashboard"} />
  <ScreenSnippet source={termsPage} name={" Terms and Conditions"} />
</ProjectLayout>
