---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ScreenSnippet from "../../components/ScreenSnippet";
import { projects } from "../../constants";

// Only Show the selected project from the projects array
const filteredProject = projects.filter((project) => {
  return project.link === "project/wembley-stadium";
});
const project = { ...filteredProject[0] };
---

<ProjectLayout
  project={project}
  title="Wemnley Stadium Website - Takinur Portfolio"
>
  <ScreenSnippet source="/images/wembley-landing.png" name="Landing Page" />
  <ScreenSnippet source="/images/wembley-plan.png" name="Plan Visit Page" />
  <ScreenSnippet source="/images/wembley-booking.png" name="Booking Screen" />
  <ScreenSnippet source="/images/wembley-events.png" name="Upcoming Events" />
  <ScreenSnippet source="/images/wembley-venue-hire.png" name="Venue Hire " />
</ProjectLayout>
