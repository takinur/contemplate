---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ScreenSnippet from "../../components/ScreenSnippet";
import { projects } from "../../constants";

// Only Show the zero-two project from the projects array
const filteredProject = projects.filter((project) => {
  return project.link === "project/zero-two";
});
const project = { ...filteredProject[0] };
---

<ProjectLayout
  project={project}
  title="Reversed Job Platform - Takinur Portfolio"
>
  <ScreenSnippet source="/images/zero-two.gif" name="Main Screen" />
</ProjectLayout>
